{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/client/*": ["./client/*"],
      "@/server/*": ["./server/*"],
      "@/components/*": ["./client/components/*"],
      "@/hooks/*": ["./client/hooks/*"],
      "@/lib/case-audio": ["./client/audio/case-audio"],
      "@/lib/supabase/*": ["./client/supabase/*"],
      "@/lib/*": ["./client/lib/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "client/**/*.ts",
    "client/**/*.tsx",
    "server/**/*.ts",
    "instrumentation.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
