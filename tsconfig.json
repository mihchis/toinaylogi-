{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/client/*": ["./src/client/*"],
      "@/server/*": ["./src/server/*"],
      "@/components/*": ["./src/client/components/*"],
      "@/hooks/*": ["./src/client/hooks/*"],
      "@/lib/case-audio": ["./src/client/audio/case-audio"],
      "@/lib/supabase/*": ["./src/client/supabase/*"],
      "@/lib/*": ["./src/client/lib/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
